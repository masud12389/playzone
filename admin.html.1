<script>

const SUPABASE_URL = "https://cavrhkprzbbtimlixbqp.supabase.co";

/*
  এখানে আপনার Supabase publishable key বসাবেন।
  আপনার বর্তমান index.html-এ যে publishable key ব্যবহার করেছেন,
  একই key এখানে ব্যবহার করুন।
*/

const SUPABASE_KEY = "publishable_1beggLIRSqVDwD3LsXYM5A_IhAYRqWL";

const client = supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);


const loginBox = document.getElementById("loginBox");
const adminApp = document.getElementById("adminApp");
const loginMsg = document.getElementById("loginMsg");
const adminStatus = document.getElementById("adminStatus");
const content = document.getElementById("content");


function message(text, type=""){
  loginMsg.textContent = text;
  loginMsg.className = "status " + type;
}


async function login(){

  const email =
    document.getElementById("email").value.trim();

  const password =
    document.getElementById("password").value;

  if(!email || !password){
    message("Email এবং Password দিন।","error");
    return;
  }

  message("Login হচ্ছে...");

  const {error} =
    await client.auth.signInWithPassword({
      email,
      password
    });

  if(error){
    message(error.message,"error");
    return;
  }

  await checkAdmin();

}


document
.getElementById("loginBtn")
.addEventListener("click",login);


async function checkAdmin(){

  const {
    data:{user}
  } = await client.auth.getUser();

  if(!user){

    loginBox.classList.remove("hidden");
    adminApp.classList.add("hidden");

    return;
  }


  const {data,error} =
    await client
      .from("admin_users")
      .select("role")
      .eq("user_id",user.id)
      .maybeSingle();


  if(error){

    loginBox.classList.remove("hidden");
    adminApp.classList.add("hidden");

    message(
      "Admin যাচাই করা যাচ্ছে না: "+error.message,
      "error"
    );

    return;
  }


  if(!data){

    loginBox.classList.remove("hidden");
    adminApp.classList.add("hidden");

    message(
      "এই account-এর Admin permission নেই।",
      "error"
    );

    return;
  }


  if(data.role !== "super_admin" && data.role !== "admin"){

    loginBox.classList.remove("hidden");
    adminApp.classList.add("hidden");

    message(
      "এই account-এর অনুমোদিত Admin role নেই।",
      "error"
    );

    return;
  }


  loginBox.classList.add("hidden");
  adminApp.classList.remove("hidden");

  adminStatus.innerHTML =
    "✅ Admin access সক্রিয় — Role: <b>"
    + data.role
    + "</b>";

  await loadDashboard();

}


async function logout(){

  await client.auth.signOut();

  adminApp.classList.add("hidden");
  loginBox.classList.remove("hidden");

}


document
.getElementById("logoutBtn")
.addEventListener("click",logout);


async function countTable(table){

  const {count,error} =
    await client
      .from(table)
      .select("*",{count:"exact",head:true});

  if(error) return "—";

  return count ?? 0;
}


async function loadDashboard(){

  document.getElementById("usersCount").textContent =
    await countTable("profiles");

  document.getElementById("jobsCount").textContent =
    await countTable("jobs");

  document.getElementById("applicationsCount").textContent =
    await countTable("job_applications");

  document.getElementById("sponsorsCount").textContent =
    await countTable("sponsor_requests");

  document.getElementById("payoutsCount").textContent =
    await countTable("payout_requests");

  loadSection("users");

}


async function loadSection(section){

  content.innerHTML = "Loading...";


  if(section === "users"){
    await loadUsers();
    return;
  }

  if(section === "jobs"){
    await loadJobs();
    return;
  }

  if(section === "applications"){
    await loadApplications();
    return;
  }

  if(section === "sponsors"){
    await loadSponsors();
    return;
  }

  if(section === "payouts"){
    await loadPayouts();
    return;
  }

  if(section === "games"){
    await loadGames();
    return;
  }

  if(section === "tournaments"){
    await loadTournaments();
    return;
  }

}


async function loadUsers(){

  const {data,error} =
    await client
      .from("profiles")
      .select("*")
      .order("created_at",{ascending:false})
      .limit(100);

  if(error){
    content.innerHTML =
      `<div class="error">Users load error: ${escapeHtml(error.message)}</div>`;
    return;
  }

  if(!data.length){
    content.innerHTML = "কোনো User পাওয়া যায়নি।";
    return;
  }

  let html = `
    <h2>👥 Users</h2>
    <div class="table-wrap">
    <table>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Points</th>
      <th>Status</th>
      <th>Created</th>
    </tr>
  `;

  data.forEach(row => {

    html += `
      <tr>
        <td>${escapeHtml(row.name || "—")}</td>
        <td>${escapeHtml(row.email || "—")}</td>
        <td>${escapeHtml(String(row.points ?? 0))}</td>
        <td><span class="badge">${escapeHtml(row.status || "active")}</span></td>
        <td>${formatDate(row.created_at)}</td>
      </tr>
    `;

  });

  html += "</table></div>";

  content.innerHTML = html;

}


